[user]
	name = izayoilv
	email = izayoilv@gmail.com
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    syntax-theme = kanagawa
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
    tool = difftastic
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[pager]
    difftool = true
[alias]
    dft = difftool
[absorb]
    maxStack = 50
    oneFixupPerCommit = false
[init]
	templateDir = /home/izayoilv/.config/git/template
	defaultBranch = main
[sequence]
    editor = interactive-rebase-tool
[credential]
	helper = cache --timeout 28800
	helper = /home/izayoilv/bin/git-credential-keepassxc
