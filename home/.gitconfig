[user]
	name = IzayoiKr
	email = izayoilv@gmail.com
[credential]
	helper = store
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    syntax-theme = kanagawa
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
    tool = difftastic
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[pager]
    difftool = true
[alias]
    dft = difftool
[absorb]
    maxStack = 50
    oneFixupPerCommit = false
[init]
	templateDir = /home/izayoilv/.config/git/template
[sequence]
    editor = interactive-rebase-tool
