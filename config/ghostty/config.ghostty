font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = +liga,+calt,+dlig

theme = Kanagawa Wave
background-opacity = 0.90
# background-blur is only supported on macOS and KDE Plasma (KWin).
# COSMIC's compositor does not implement blur, so it is a no-op here.
# background-blur = true

cursor-style = block
cursor-style-blink = true
cursor-color = #7e9cd8

mouse-hide-while-typing = true
copy-on-select = true
clipboard-paste-protection = true

scrollback-limit = 10000000
adjust-cell-height = 10%
minimum-contrast = 1.1
confirm-close-surface = false

shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo

window-decoration = false
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-theme = dark
window-save-state = always
unfocused-split-opacity = 0.85
split-divider-color = #7e9cd8

# splits / tabs
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab

# Vim-style split navigation
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
