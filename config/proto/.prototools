node = "latest"
npm = "latest"
pnpm = "latest"
bun = "latest"
go = "latest"
ruby = "latest"
uv = "latest"
rust = "latest"
java = "temurin-21"
kotlin = "2.4"

[settings]
auto-clean = false
auto-install = false
builtin-backends = false
community-tools = false
telemetry = false

[settings.build]
install-system-packages = false

[settings.http]
allow-invalid-certs = false
