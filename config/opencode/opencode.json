  "instructions": [
    "/home/izayoilv/.config/opencode/instructions/verify-latest.md",
    "/home/izayoilv/.config/opencode/instructions/memory.md",
    "/home/izayoilv/.config/opencode/instructions/code-style.md",
    "/home/izayoilv/.config/opencode/instructions/docs-location.md"
  ],
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "agents": {
    "title": { "model": "opencode-go/deepseek-v4.1-flash#high" }
  },
  "formatter": true,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/target/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.venv/**"
    ]
  },
  "experimental": {
    "todo": true,
    "background_compaction": true,
    "subagent_depth": 2
  }
}
